{
  "name": "yak-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint .",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r exec vitest run --passWithNoTests",
    "pack:all": "pnpm -r exec pnpm pack --pack-destination ../../packed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.1"
  }
}
